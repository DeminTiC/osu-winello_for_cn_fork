#!/usr/bin/env bash
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export BINDIR="${BINDIR:-$HOME/.local/bin}"

## 欢迎使用 osu! 启动脚本！

set -a
## 将你的启动选项添加到 $XDG_DATA_HOME/osuconfig/configs 下的文件中，
## 通常位于 ~/.local/share/osuconfig/configs
## 你可以参考 $XDG_DATA_HOME/osuconfig/configs/example.cfg 中的常见选项（也位于 git 仓库的 'stuff/' 目录下）。
## 该示例文件不会被覆盖，但你可以复制/重命名它，只要以 .cfg 结尾即可。

## 变量已在注释中说明，如果你只需要在 osu! 前添加参数（如 gamemoderun 或 mangohud），请使用 'PRE_LAUNCH_ARGS'！

source "$XDG_DATA_HOME/osuconfig/configs/"*.cfg 2>/dev/null
set +a

###################################################################################################
# osu-winello 内部变量，通常无需修改
###################################################################################################

set -a
# 不要修改此 'winello-default' 文件！更新时会被覆盖。
source "$XDG_DATA_HOME/osuconfig/update/stuff/winello-default.cfg"
set +a

export WINE="${WINE:-$XDG_DATA_HOME/osuconfig/yawl-winello}"
export WINESERVER="${WINESERVER:-${WINE}server}"
export WINEPREFIX="${WINEPREFIX:-$XDG_DATA_HOME/wineprefixes/osu-wineprefix}"
export WINE_INSTALL_PATH="${WINE_INSTALL_PATH:-$XDG_DATA_HOME/osuconfig/wine-osu}"

export WINETRICKS="${WINETRICKS:-$XDG_DATA_HOME/osuconfig/winetricks}"

export WINEDLLOVERRIDES="winemenubuilder.exe=;" # 阻止 Wine 创建 .desktop 文件

LAUNCHERPATH="$(realpath "$0")"
export LAUNCHERPATH

# 使所有路径对 pressure-vessel 可见
_mainscriptpath="$(realpath "$XDG_DATA_HOME/osuconfig/update/osu-winello.sh")"
_mountline="$(df -P "$_mainscriptpath" 2>/dev/null | tail -1)" && [ -n "${_mountline}" ] && _mainscript_mount="${_mountline##* }:" # 主脚本所在挂载点
_mountline="$(df -P "$LAUNCHERPATH" 2>/dev/null | tail -1)" && [ -n "${_mountline}" ] && _curdir_mount="${_mountline##* }:"        # 当前目录挂载点
_mountline="$(df -P "$XDG_DATA_HOME" 2>/dev/null | tail -1)" && [ -n "${_mountline}" ] && _home_mount="${_mountline##* }:"         # XDG_DATA_HOME 挂载点
PRESSURE_VESSEL_FILESYSTEMS_RW+="${_mainscript_mount:-}${_curdir_mount:-}${_home_mount:-}/mnt:/media:/run/media"
[ -r "$XDG_DATA_HOME/osuconfig/osupath" ] && OSUPATH=$(</"$XDG_DATA_HOME/osuconfig/osupath") &&
    PRESSURE_VESSEL_FILESYSTEMS_RW+=":$(realpath "$OSUPATH"):$(realpath "$OSUPATH"/Songs 2>/dev/null)" # osu 目录及歌曲目录挂载点
export PRESSURE_VESSEL_FILESYSTEMS_RW="${PRESSURE_VESSEL_FILESYSTEMS_RW//\/:/:}" OSUPATH               # 清理单独的 "/" 挂载

mapfile -t configs < <(find "$XDG_DATA_HOME/osuconfig/configs" -name '*.cfg')

###################################################################################################
# 启动器脚本的辅助函数
###################################################################################################

Help() {
    Info "注意：任何命令前可加字母 'n' 以避免运行时更新，例如：
          \`osu-wine n --fixprefix\` 将运行 \`--fixprefix\` 而不会从 osu-winello git 仓库覆盖你的任何文件。
    脚本功能：
    osu-wine                     ：运行 osu!
    osu-wine --help              ：显示本帮助
    osu-wine --info              ：故障排除及更多信息
    osu-wine --edit-config       ：打开配置文件以编辑启动参数及其他自定义设置
    osu-wine --winecfg           ：在 osu! Wineprefix 上运行 winecfg
    osu-wine --winetricks        ：在 osu! Wineprefix 上安装软件包
    osu-wine --regedit           ：在 osu! Wineprefix 上打开注册表编辑器
    osu-wine --wine <参数>       ：如同在 osu! 的 wineprefix 中直接运行 wine 加上你的参数
    osu-wine --kill              ：终止 osu! 及 osu! Wineprefix 中的相关进程
    osu-wine --kill9             ：使用 wineserver -k9 强制终止 osu!
    osu-wine --update            ：将 wine-osu 更新到最新版本
    osu-wine --fixprefix         ：从系统重新安装 osu! Wineprefix（使用 --fixprefix --redl 可重新下载预构建的 prefix）
    osu-wine --fixfolders        ：重新配置 osu-handler 和原生文件集成（如果 osu!direct/.osz/.osk 处理或游戏内打开文件夹/.osu/.osb 文件出现问题，请运行此命令）
    osu-wine --fix-yawl          ：重新安装 yawl 和 Steam Runtime 相关文件（若出现问题）
    osu-wine --fixrpc            ：重新安装 rpc-bridge（如需）
    osu-wine --remove            ：卸载脚本和/或卸载 osu!
    osu-wine --changedir         ：根据用户选择更改游戏安装目录
    osu-wine --devserver <地址>  ：使用备用服务器运行 osu!（例如 --devserver akatsuki.gg）
    osu-wine --osuhandler <谱面/皮肤...>：使用指定的文件/链接启动 osu-handler-wine
    osu-wine --gosumemory        ：安装并运行 gosumemory，无需额外配置！
    osu-wine --tosu              ：安装并运行 tosu，无需额外配置！
    osu-wine --disable-memory-reader：关闭 gosumemory 和 tosu
    osu-wine --akatsuki          ：安装并运行 Akatsuki patcher
    osu-wine --mappingtools      ：安装并运行 osu! Mapping Tools（实验性，建议设置 WINE_USE_CACHY=true）"
}

# 即使无网络连接也不会返回失败，但会先尝试更新主脚本，再调用函数
MainScriptUpdate() {
    _clone() { GIT_TERMINAL_PROMPT=0 git clone "https://github.com/NelloKudo/osu-winello.git" "$XDG_DATA_HOME/osuconfig/update" --quiet 2>/dev/null; }
    _pull() { GIT_TERMINAL_PROMPT=0 git -C "$XDG_DATA_HOME/osuconfig/update" pull --quiet 2>/dev/null; }
    _reset() { GIT_TERMINAL_PROMPT=0 git -C "$XDG_DATA_HOME/osuconfig/update" reset --hard "${1:-HEAD}" --quiet 2>/dev/null; }
    if [ ! -d "$XDG_DATA_HOME/osuconfig/update" ]; then
        _clone # 更新目录丢失，需要重新克隆
    else
        _pull || { _reset origin/main && _pull; } # 处理分支变更/主分支改名的情况
    fi
    _reset
    # 再次检查，确保没问题
    [ -d "$XDG_DATA_HOME/osuconfig/update" ] || ErrorAndExit "你的 osu-winello 文件夹已损坏，请从头重新安装..."
    MainScript "${@:-}"
    return $?
}

# 与上面相同，但不检查更新
MainScript() {
    declare -a CMD POST_ARGS
    POST_ARGS=("${@:-}")
    CMD=("bash")
    # 检查 MainScript(Update) exec <command> 以避免调用主脚本后再次进入启动器
    [[ "${POST_ARGS[0]}" = exec* ]] && CMD=("exec" "bash") && POST_ARGS=("${POST_ARGS[@]:1}")
    [ -z "${POST_ARGS[*]}" ] && ErrorAndExit "(内部) 缺少参数？"

    "${CMD[@]}" "$XDG_DATA_HOME/osuconfig/update/osu-winello.sh" "${POST_ARGS[@]}"
    return $? # 如果使用 exec 则不会到达这里
}

if MainScript "detectabsolutetablethack" 2>/dev/null; then
    export WINE_ENABLE_ABS_TABLET_HACK=2
    is_otd_abs_mode=1
fi

# 配置文件中启用 wine-osu-cachy 时使用
if [ "$WINE_USE_CACHY" == "true" ]; then
    MainScript winecachy-setup
    export WINE="$XDG_DATA_HOME/osuconfig/yawl-winello-cachy"
    export WINE_INSTALL_PATH="$XDG_DATA_HOME/osuconfig/wine-osu-cachy-10.0"
fi

# 允许使用捆绑的 gstreamer
if [ -f "${WINE_INSTALL_PATH}/lib/wine/x86_64-unix/libgstfaad.so" ]; then
    export GST_PLUGIN_SYSTEM_PATH_1_0="${WINE_INSTALL_PATH}/lib/wine/x86_64-unix"
    export WINE_GST_REGISTRY_DIR="${WINEPREFIX}/gstreamer-1.0"
    mkdir -p "${WINE_GST_REGISTRY_DIR}"
fi

LaunchOsu() {
    if [ "${is_otd_abs_mode:-}" = "1" ]; then
        Info "检测到 OpenTabletDriver 绝对模式，已启用 WINE_ENABLE_ABS_TABLET_HACK=2。"
        Info "如果鼠标出现问题，请在配置中设置 WINE_ENABLE_ABS_TABLET_HACK=0（osu-wine --edit-config）。"
    fi

    declare -a PRE_ARGS POST_ARGS
    # 仅当未向 LaunchOsu 传递参数时才使用配置文件中的自定义参数
    if [ -z "${*}" ]; then
        # 注意：双空格可能无法正确处理
        IFS=" " read -r -a POST_ARGS <<<"${POST_LAUNCH_ARGS}"
    else
        POST_ARGS=("${@:-}")
    fi
    IFS=" " read -r -a PRE_ARGS <<<"env ${PRE_LAUNCH_ARGS}"

    Info "正在打开：$OSUPATH/osu!.exe ${POST_ARGS[*]}"
    if [ -f "${OSUPATH}/launch_with_memory.bat" ]; then
        if command -v pgrep &>/dev/null; then
            { pgrep 'osu!.exe' &>/dev/null; } || $WINESERVER -k # 如果有残留的 tosu 进程则终止
        fi
        OSU_EXE=("launch_with_memory.bat")
        Info "点击此处打开 tosu/gosumemory 页面：http://localhost:24050 或 http://127.0.0.1:24050"
    else
        OSU_EXE=("osu!.exe")
    fi
    WINELLO_LOGS_PATH="${XDG_DATA_HOME}/osuconfig/winello.log"

    echo "使用的配置：${configs[*]}" &>"${WINELLO_LOGS_PATH}"

    Info "运行日志位于 ${WINELLO_LOGS_PATH}。如果在 GitHub 上提交问题或在 Discord 上寻求帮助，请附上此文件。"
    Info "正在启动：${PRE_ARGS[*]} ${WINE} ${OSU_EXE[*]} ${POST_ARGS[*]}"

    export WINEDEBUG="+timestamp,+pid,+tid,+threadname,+debugstr,+loaddll,+winebrowser,+exec${WINEDEBUG:+,${WINEDEBUG}}"
    cd "${OSUPATH}" || { Error "无法切换到 osu! 目录... 你删除了它吗？请尝试 \`osu-wine --changedir\`。" && return 1; }
    exec "${PRE_ARGS[@]}" "${WINE}" "${OSU_EXE[@]}" "${POST_ARGS[@]}" &>>"${WINELLO_LOGS_PATH}" || return 1
    return 0
}

Info() {
    echo -e '\033[1;34m'"Winello:\033[0m $*"
}

Warning() {
    echo -e '\033[0;33m'"Winello:\033[0m $*"
}

Error() {
    echo -e '\033[1;31m'"Winello (错误):\033[0m $*"
}

ErrorAndExit() {
    echo -e '\033[1;31m'"脚本失败:\033[0m $*"
    exit 1
}

###################################################################################################
# 开始参数处理
###################################################################################################

# 默认使用 MainScriptUpdate，允许通过配置覆盖
: "${mainscriptcommand:=MainScriptUpdate}"

case "$1" in
'n')
    # 运行命令前不更新启动器
    # 例如：osu-wine n --fixprefix
    mainscriptcommand=MainScript
    export NOLAUNCHERUPDATE=1 # 告知 osu-winello.sh 不要更新/覆盖 osu-wine
    shift
    ;;
esac

shopt -s extglob

case "$1" in
'--devserver')
    if [ -z "$2" ]; then ErrorAndExit "请指定服务器地址，例如 --devserver akatsuki.gg"; fi
    LaunchOsu "-devserver" "${@:2}"
    ;;

    ###################################################################################################

'--wine')
    "$WINE" "${@:2}"
    ;;

    ###################################################################################################

'--regedit')
    "$WINE" regedit
    ;;

    ###################################################################################################

'--winecfg')
    "$WINE" winecfg
    ;;

    ###################################################################################################

'--edit-config')
    Info "正在打开配置文件：${configs[*]}"
    command -v "${CUSTOMEDITOR}" >/dev/null 2>&1 && exec "${CUSTOMEDITOR}" "${configs[*]}"
    xdg-open "${configs[*]}" || ErrorAndExit "无法打开配置文件，没有可用的文本编辑器..."
    ;;

    ###################################################################################################

'--winetricks')
    [ ! -x "$XDG_DATA_HOME/osuconfig/winetricks" ] && { $mainscriptcommand "installwinetricks" || ErrorAndExit "无法安装 winetricks..."; }
    "$WINETRICKS" "${@:2}" || ErrorAndExit "winetricks 命令执行出错..."
    ;;

    ###################################################################################################

'--changedir')
    $mainscriptcommand "changedir" || ErrorAndExit "更改目录失败..."
    ;;

    ###################################################################################################

'--remove')
    $mainscriptcommand "uninstall" || ErrorAndExit "可能需要手动卸载/删除目录..."
    ;;

    ###################################################################################################

'--kill')
    "$WINESERVER" -k
    ;;

    ###################################################################################################

'--kill9')
    "$WINESERVER" -k9
    ;;

    ###################################################################################################

'--update')
    # 虽然在更新时允许“不更新”看似多余，但保持行为一致更好
    $mainscriptcommand "exec" "update" || ErrorAndExit "更新部分或完全失败..."
    ;;

    ###################################################################################################

'--fixfolders')
    $mainscriptcommand "fixfolders" || Error "原生文件管理器集成失败，但仍将尝试修复 osu-handler..."
    $mainscriptcommand "fixosuhandler" || ErrorAndExit "osu-handler 设置失败..."
    ;;

    ###################################################################################################

*--fix*yawl*)
    $mainscriptcommand "fixyawl" || ErrorAndExit "yawl 可能未能修复..."
    ;;

    ###################################################################################################

'--fixrpc')
    $mainscriptcommand "discordrpc" || ErrorAndExit "Discord RPC bridge 安装出错..."
    ;;

    ###################################################################################################

'--fixprefix')
    $mainscriptcommand "fixprefix" "${2:-}" ||
        ErrorAndExit "prefix 设置出现问题... 可能仍然有效，可以尝试运行 osu!，如果不行再重新运行 --fixprefix。"
    $mainscriptcommand "fixosuhandler" || ErrorAndExit "osu-handler 设置失败..."
    ;;

    ###################################################################################################

'--tosu')
    $mainscriptcommand "tosu" || ErrorAndExit "无法设置 tosu..."
    ;;
'--gosumemory')
    $mainscriptcommand "gosumemory" || ErrorAndExit "无法设置 gosumemory..."
    ;;

    ###################################################################################################

'--akatsuki')
    MainScript "akatsukiPatcher" || ErrorAndExit "无法启动 akatsuki patcher..."
    ;;

    ###################################################################################################

'--mappingtools')
    MainScript "mappingTools" || ErrorAndExit "无法启动 Mapping Tools..."
    ;;

    ###################################################################################################

*--disable-@(*osu*|memory*))
    rm -f "$OSUPATH/launch_with_memory.bat"
    Info "内存读取器（tosu/gosumemory）已禁用。"
    ;;

    ###################################################################################################

'--osuhandler')
    # 不更新以避免不必要的延迟
    MainScript "exec" "handle" "${@:2}"
    ;;

    ###################################################################################################

'--info')
    Info "需要信息？：
    Wineprefix 位置：$WINEPREFIX
    osu! 文件夹：'$OSUPATH'

    如需向 osu! 添加更多选项，请检查脚本的 Launch 函数（例如 nano $BINDIR/osu-wine）
    运行 'osu-wine --help' 可查看所有脚本功能（修复 prefix、更改目录等）
    更多故障排除和信息请访问：https://osu.ppy.sh/community/forums/topics/1248084?n=1

    如果遇到错误 'Runtime Platform missing or download incomplete'，请尝试运行 'osu-wine --fix-yawl'。"
    ;;

    ###################################################################################################

*--help*)
    Help
    ;;

    ###################################################################################################

*)
    # 默认运行 osu
    LaunchOsu "${@:1}"
    ;;
esac
